# One account (most people): SendPulse > Account settings > API
SENDPULSE_CLIENT_ID=your-api-id
SENDPULSE_CLIENT_SECRET=your-api-secret

# Several accounts instead: a JSON object, one entry per account name
# SENDPULSE_ACCOUNTS={"brand_a":{"id":"...","secret":"..."},"brand_b":{"id":"...","secret":"..."}}

# 1 = expose only the 10 read tools (no sending, tagging, flows or campaigns)
SENDPULSE_READ_ONLY=1
